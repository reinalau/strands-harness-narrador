# Copy this file to .env and fill in your real values.
# .env is gitignored; this .example is the template committed to the repo.

# Google Gemini API key (used by the orchestrator / narrator).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: AWS region for the Bedrock subagents (Nova Lite). Defaults to us-east-1.
# AWS_REGION=us-east-1

# AWS credentials for Amazon Bedrock are usually taken from your standard setup
# (~/.aws/credentials, a profile, env vars, or an IAM role), so you normally do NOT
# need to set them here. If you prefer, you can define them explicitly:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Alternatively, a Bedrock API key via bearer token:
# AWS_BEARER_TOKEN_BEDROCK=
